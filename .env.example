MOODLE_PHP_IMAGE_TAG=8.3
POSTGRES_IMAGE_TAG=16-alpine
REDIS_IMAGE_TAG=7.4-alpine
MOODLE_GIT_REPOSITORY=https://github.com/moodle/moodle.git
MOODLE_GIT_BRANCH=MOODLE_500_STABLE

POSTGRES_DB=tau_moodle
POSTGRES_USER=tau_admin
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres

MOODLE_URL=http://localhost:8080
MOODLE_USERNAME=admin
MOODLE_PASSWORD=admin123*
MOODLE_EMAIL=admin@tau.local
MOODLE_SITE_NAME=E-TAU Campus Virtual
MOODLE_SHORT_NAME=TAU
MOODLE_SITE_SUMMARY=Campus virtual institucional TAU
MOODLE_DEFAULT_THEME=boost_union
APACHE_DOCUMENT_ROOT=/var/www/html
MOOVE_BRANCH=MOODLE_500_STABLE

REDIS_HOST=redis
REDIS_PORT=6379
MOODLE_REVERSEPROXY_ADDRESSES=172.16.0.0/12,127.0.0.1
MOODLE_CACHE_PREFIX=taucv_cache_
MOODLE_SESSION_PREFIX=taucv_sess_

JWT_SECRET=replace_with_a_long_random_secret
REDIS_PASSWORD=change_me_redis

VITE_API_URL=http://localhost:4000/api

# Google OAuth2 for Moodle
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ALLOWED_DOMAIN=unicesmag.edu.co

# TAU AI Plugins (configured in Moodle Admin > Plugins > Local > TAU AI Provider)
# These values are set via Moodle admin UI after first install, not via docker env.
# TAU_AI_BACKEND_URL = URL base del backend Node.js  (ej: http://localhost:4000/api)
# TAU_AI_API_KEY     = Clave de autenticación para el backend TAU AI

# Share Certificate AI — LinkedIn OAuth2
# Native Moodle Ollama provider
# Local Docker Desktop default:
OLLAMA_ENABLE=true
OLLAMA_PROVIDER_NAME=Ollama Local
OLLAMA_ENDPOINT=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_PREFER=true
OLLAMA_DISABLE_OPENAI=true
OLLAMA_ENABLE_BASIC_AUTH=false
OLLAMA_USERNAME=
OLLAMA_PASSWORD=
# On a Linux server, replace OLLAMA_ENDPOINT with the hostname or IP
# where Ollama will be reachable from the Moodle container.

# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
