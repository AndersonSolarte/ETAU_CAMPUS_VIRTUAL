{
  "name": "tau-campus-virtual",
  "private": true,
  "version": "0.1.0",
  "description": "Enterprise LMS platform based on Moodle 5.x, React and Node.js",
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel frontend backend",
    "frontend": "npm --workspace apps/frontend run dev",
    "backend": "npm --workspace apps/backend run dev",
    "build": "npm-run-all build:landing build:api",
    "build:landing": "npm --workspace apps/frontend run build",
    "build:api": "npm --workspace apps/backend run build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "playwright": "^1.60.0"
  }
}
